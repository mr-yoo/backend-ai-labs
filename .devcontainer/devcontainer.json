{
  "name": "Backend AI Labs (Java 21 + Maven)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "npm install -g @openai/codex",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "openai.chatgpt",
        "darkstyle.codex-token-usage-for-enterprises"
      ]
    }
  },
  "forwardPorts": [
    8080
  ]
}
